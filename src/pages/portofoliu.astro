---
import BaseLayout from '../layouts/BaseLayout.astro';
import { u } from '../lib/url';
import SectionBreath from '../components/SectionBreath.astro';
---

<BaseLayout
  title="Portofoliu · Thorn Industries"
  description="Aplicații construite și administrate de Thorn Industries: Evenimente Cluj, o platformă care centralizează date din 19 surse publice, și Earth Patchers, o aplicație educațională bilingvă."
  lang="ro"
>

  <!-- HERO -->
  <section class="surface-light pt-12 md:pt-20 pb-16 md:pb-24">
    <div class="container-page">
      <div class="eyebrow text-forest-700 mb-8 md:mb-10">
        <span class="font-mono">001</span>
        <span class="mx-3 text-ink-300">·</span>
        Portofoliu
      </div>
      <h1 class="font-sans font-medium text-display-1 text-ink-900 hang max-w-4xl">
        Proiecte pe care<br/>
        <span class="text-ink-400">le puteți vedea în funcțiune.</span>
      </h1>
      <div class="mt-12 md:mt-16 max-w-2xl">
        <p class="text-body-lg text-ink-700 leading-relaxed">
          Mai jos găsiți aplicații construite și administrate de noi. Le puteți deschide, testa și vedea cum funcționează în condiții reale.
        </p>
      </div>
    </div>
  </section>

  <!-- CASE 1: EVENIMENTE CLUJ -->
  <section class="surface-medium section">
    <div class="container-page">
      <div class="grid md:grid-cols-12 gap-10 mb-12 md:mb-16">
        <div class="md:col-span-3">
          <div class="eyebrow text-forest-700 mb-3">002</div>
          <div class="text-ink-500 text-body-sm font-mono">Studiu de caz</div>
        </div>
        <div class="md:col-span-9">
          <h2 class="font-sans font-medium text-display-2 text-ink-900 leading-[1.05] hang tracking-tight">
            Evenimente Cluj.<br/>
            <span class="text-ink-400">Agenda orașului, centralizată automat.</span>
          </h2>
        </div>
      </div>

      <figure class="project-showcase project-showcase-events mb-12 md:mb-16">
        <div class="showcase-orbit"></div>
        <img src={u('/images/evenimente-screen.jpg')} alt="Interfața platformei Evenimente Cluj" loading="lazy" />
        <figcaption>19 surse publice centralizate</figcaption>
      </figure>

      <div class="grid md:grid-cols-12 gap-10">
        <div class="md:col-span-7">
          <p class="text-body-lg text-ink-700 leading-relaxed mb-6">
            Informațiile despre evenimente erau răspândite pe site-urile instituțiilor, ale organizatorilor și în diferite comunități online. Pentru locuitori era dificil să afle, într-un singur loc, ce se întâmplă în oraș.
          </p>
          <p class="text-ink-700 text-body leading-relaxed mb-6">
            Am construit o platformă care colectează automat evenimente din 19 surse publice, elimină înregistrările duplicate și publică informațiile într-o agendă unică. Platforma include și un sistem de emitere și administrare a biletelor, găzduit de noi.
          </p>
          <p class="text-ink-700 text-body leading-relaxed mb-10">
            Același tip de soluție poate centraliza informații din surse diferite, le poate verifica și publica automat într-un format ușor de folosit.
          </p>
          <div class="flex flex-wrap items-center gap-3">
            <a href="https://evenimente.iotcafe.net" target="_blank" rel="noopener" class="btn-primary">
              Deschideți portalul
              <svg class="btn-arrow" width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
                <path d="M0 5h12M8 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" fill="none"/>
              </svg>
            </a>
            <a href="https://events.iotcafe.net" target="_blank" rel="noopener" class="btn-secondary">
              Platforma de bilete
            </a>
          </div>
        </div>

        <aside class="md:col-span-4 md:col-start-9 md:border-l md:border-forest-100 md:pl-6">
          <dl class="space-y-6 text-body-sm">
            <div>
              <dt class="eyebrow text-ink-500 mb-2">Surse monitorizate</dt>
              <dd class="font-mono tabular text-ink-900">19</dd>
            </div>
            <div>
              <dt class="eyebrow text-ink-500 mb-2">Ce a cerut</dt>
              <dd class="text-ink-700 leading-relaxed">Colectare din surse eterogene, deduplicare, taxonomie de etichete, publicare automată</dd>
            </div>
            <div>
              <dt class="eyebrow text-ink-500 mb-2">Găzduire</dt>
              <dd class="text-ink-700 leading-relaxed">Self-hosted, pe infrastructura noastră</dd>
            </div>
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <SectionBreath label="Al doilea studiu de caz" tone="light" />

  <!-- CASE 2: EARTH PATCHERS -->
  <section class="surface-light section">
    <div class="container-page">
      <div class="grid md:grid-cols-12 gap-10 mb-12 md:mb-16">
        <div class="md:col-span-3">
          <div class="eyebrow text-forest-700 mb-3">003</div>
          <div class="text-ink-500 text-body-sm font-mono">Studiu de caz</div>
        </div>
        <div class="md:col-span-9">
          <h2 class="font-sans font-medium text-display-2 text-ink-900 leading-[1.05] hang tracking-tight">
            Earth Patchers.<br/>
            <span class="text-ink-400">O platformă educațională construită și lansată în câteva zile.</span>
          </h2>
        </div>
      </div>

      <figure class="project-showcase project-showcase-earth mb-12 md:mb-16">
        <div class="showcase-orbit"></div>
        <img src={u('/images/earthpatchers-screen.jpg')} alt="Interfața aplicației EarthPatchers" loading="lazy" />
        <figcaption>51 de misiuni bilingve</figcaption>
      </figure>

      <div class="grid md:grid-cols-12 gap-10">
        <div class="md:col-span-7">
          <p class="text-body-lg text-ink-700 leading-relaxed mb-6">
            Proiectul avea nevoie de o aplicație în care copiii și familiile să primească misiuni pentru protejarea naturii, să le realizeze în lumea reală și să trimită dovezi pentru validare.
          </p>
          <p class="text-ink-700 text-body leading-relaxed mb-6">
            Am construit aplicația în română și engleză, sistemul de conturi și validare, precum și un panou din care echipa poate administra singură conținutul. Platforma este găzduită și monitorizată de noi, cu copii de siguranță zilnice.
          </p>
          <p class="text-ink-700 text-body leading-relaxed mb-10">
            După lansare, am îmbunătățit aplicația pe baza feedbackului primit de la utilizatori.
          </p>
          <div class="flex flex-wrap items-center gap-3">
            <a href="https://app.earthpatchers.org" target="_blank" rel="noopener" class="btn-primary">
              Deschideți aplicația
              <svg class="btn-arrow" width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
                <path d="M0 5h12M8 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" fill="none"/>
              </svg>
            </a>
          </div>
        </div>

        <aside class="md:col-span-4 md:col-start-9 md:border-l md:border-forest-100 md:pl-6">
          <dl class="space-y-6 text-body-sm">
            <div>
              <dt class="eyebrow text-ink-500 mb-2">Misiuni la lansare</dt>
              <dd class="font-mono tabular text-ink-900">51, bilingve</dd>
            </div>
            <div>
              <dt class="eyebrow text-ink-500 mb-2">Ce a cerut</dt>
              <dd class="text-ink-700 leading-relaxed">Conturi, misiuni, validare cu dovezi, panou de administrare, email de pe domeniul propriu</dd>
            </div>
            <div>
              <dt class="eyebrow text-ink-500 mb-2">Găzduire</dt>
              <dd class="text-ink-700 leading-relaxed">Kubernetes, pe infrastructura noastră, cu backup zilnic</dd>
            </div>
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <!-- ENTERPRISE -->
  <section class="surface-dark section">
    <div class="container-page">
      <div class="grid md:grid-cols-12 gap-10">
        <div class="md:col-span-3">
          <div class="eyebrow text-forest-300 mb-3">004 · Referințe enterprise</div>
        </div>
        <div class="md:col-span-9">
          <h2 class="font-sans font-medium text-display-2 text-cream-50 leading-[1.05] hang tracking-tight mb-8">
            Experiență în platforme de date<br/>
            <span class="text-forest-300">pentru organizații mari.</span>
          </h2>
          <p class="text-cream-100/80 text-body-lg leading-relaxed max-w-2xl mb-10">
            Înainte de lansarea Thorn, am lucrat la proiecte pentru Sainsbury's, Metro, Demica, Centrica și Toyota Connected Europe, prin firme de consultanță precum OpenCredo și Mesh-AI. Experiența acumulată în platforme de date și AI este aplicată acum proiectelor Thorn.
          </p>
          <a href={u('/contact')} class="btn-primary">
            Programați o discuție
            <svg class="btn-arrow" width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
              <path d="M0 5h12M8 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" fill="none"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="surface-light section">
    <div class="container-page text-center">
      <div class="eyebrow text-forest-700 mb-6">005</div>
      <h2 class="font-sans font-medium text-display-2 text-ink-900 leading-[1.02] mb-10 hang max-w-3xl mx-auto tracking-tight">
        Aveți în plan<br/>
        <span class="text-forest-800">un proiect asemănător?</span>
      </h2>
      <p class="text-body-lg text-ink-700 max-w-xl mx-auto mb-12">
        Descrieți-ne pe scurt ce doriți să construiți. Vă spunem ce presupune proiectul, cât poate dura și care este bugetul orientativ.
      </p>
      <a href={u('/contact')} class="btn-primary">
        Contactați-ne
        <svg class="btn-arrow" width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
          <path d="M0 5h12M8 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" fill="none"/>
        </svg>
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  .project-showcase{height:560px;position:relative;overflow:hidden;border-radius:16px;display:flex;align-items:center;justify-content:center;isolation:isolate}
  .project-showcase-events{background:radial-gradient(circle at 75% 20%,rgba(47,99,255,.22),transparent 30%),linear-gradient(145deg,#f7f9ff,#e8edff)}
  .project-showcase-earth{background:radial-gradient(circle at 20% 78%,rgba(47,99,255,.2),transparent 28%),linear-gradient(145deg,#f8f9ff,#e5ebff)}
  .project-showcase img{height:88%;width:auto;max-width:78%;object-fit:contain;position:relative;z-index:2;border-radius:9px;box-shadow:0 30px 65px rgba(35,50,94,.24);animation:portfolioFloat 6s ease-in-out infinite}
  .project-showcase figcaption{position:absolute;left:28px;bottom:25px;z-index:3;background:#2f63ff;color:white;border-radius:5px;padding:11px 15px;font:500 10px "JetBrains Mono",monospace;letter-spacing:.08em}
  .showcase-orbit{position:absolute;width:560px;height:310px;border:1px solid rgba(47,99,255,.28);border-radius:50%;transform:rotate(-14deg)}
  .showcase-orbit:after{content:'';position:absolute;inset:45px -80px;border:1px dashed rgba(47,99,255,.28);border-radius:50%;transform:rotate(28deg)}
  @keyframes portfolioFloat{0%,100%{transform:translateY(7px) rotateY(-1deg)}50%{transform:translateY(-11px) rotateY(1deg)}}
  @media(max-width:640px){.project-showcase{height:430px;border-radius:10px}.project-showcase img{height:84%;max-width:86%}.project-showcase figcaption{left:16px;bottom:16px}.showcase-orbit{width:390px;height:220px}}
</style>
