---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { u, langPair, slashed } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  lang?: 'ro' | 'en';
  noindex?: boolean;
  /** Link-preview card. Base-relative; resolved to an absolute URL below. */
  image?: string;
}

const {
  title,
  description = 'Data platforms, custom software and digitalisation consultancy for public administration and B2B companies.',
  lang = 'en',
  noindex = false,
  image = '/og-default.png',
} = Astro.props;

const site = (Astro.site?.toString() ?? 'https://thorn.ro').replace(/\/$/, '');
const pair = langPair(Astro.url.pathname);
const canonical = `${site}${slashed(lang === 'ro' ? pair.ro : pair.en)}`;
// WhatsApp, Slack and Teams only fetch absolute og:image URLs.
const ogImage = `${site}${u(image)}`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Thorn Industries',
  legalName: 'Tech Camp Pro SRL',
  url: site,
  email: 'contact@thorn.ro',
  taxID: '53945382',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Str. Traian Vuia 95',
    addressLocality: 'Cluj-Napoca',
    addressCountry: 'RO',
  },
  areaServed: {
    '@type': 'Country',
    name: lang === 'ro' ? 'România' : 'Romania',
  },
  knowsAbout:
    lang === 'ro'
      ? [
          'Inginerie de date',
          'Dezvoltare software la comandă',
          'Integrări software',
          'Consultanță în digitalizare',
        ]
      : [
          'Data engineering',
          'Custom software development',
          'Software integrations',
          'Digitalisation consultancy',
        ],
};

// Cloudflare Web Analytics: token injected at build time via CF_ANALYTICS_TOKEN.
// Absent (e.g. local dev or PR builds) -> snippet is simply not rendered.
const cfAnalyticsToken = import.meta.env.CF_ANALYTICS_TOKEN ?? '';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#243e2f" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Icons + canonical + language alternates -->
    <link rel="icon" type="image/svg+xml" href={u('/favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ro" href={`${site}${slashed(pair.ro)}`} />
    <link rel="alternate" hreflang="en" href={`${site}${slashed(pair.en)}`} />
    <link rel="alternate" hreflang="x-default" href={`${site}${slashed(pair.en)}`} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Thorn Industries" />
    <meta property="og:locale" content={lang === 'ro' ? 'ro_RO' : 'en_GB'} />
    <meta property="og:locale:alternate" content={lang === 'ro' ? 'en_GB' : 'ro_RO'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Thorn Industries" />

    <!-- Link previews -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Inter + JetBrains Mono are self-hosted (src/styles/fonts.css). No font CDN:
         loading them from Google handed every visitor's IP address to Google. -->
    <link rel="preload" href={u('/fonts/inter-latin.woff2')} as="font" type="font/woff2" crossorigin />

    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="skip-link">
      {lang === 'ro' ? 'Sari la conținut' : 'Skip to content'}
    </a>
    <Header lang={lang} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />

    <!-- Mobile drawer toggle script -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const toggle = document.getElementById('mobile-nav-toggle');
        const drawer = document.getElementById('mobile-nav-drawer');
        const closeBtn = document.getElementById('mobile-nav-close');
        const body = document.body;

        if (!toggle || !drawer) return;

        const open = () => {
          drawer.classList.remove('opacity-0', 'pointer-events-none');
          drawer.classList.add('opacity-100');
          body.classList.add('scroll-lock');
          toggle.setAttribute('aria-expanded', 'true');
          // Focus first link inside drawer
          setTimeout(() => {
            const firstLink = drawer.querySelector('a');
            if (firstLink) firstLink.focus();
          }, 150);
        };

        const close = () => {
          drawer.classList.add('opacity-0', 'pointer-events-none');
          drawer.classList.remove('opacity-100');
          body.classList.remove('scroll-lock');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.focus();
        };

        toggle.addEventListener('click', () => {
          if (toggle.getAttribute('aria-expanded') === 'true') {
            close();
          } else {
            open();
          }
        });

        if (closeBtn) closeBtn.addEventListener('click', close);

        // Close on any link click inside drawer
        drawer.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', close);
        });

        // Escape to close
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
            close();
          }
        });
      });
    </script>

    {cfAnalyticsToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${cfAnalyticsToken}"}`}
      />
    )}
  </body>
</html>
