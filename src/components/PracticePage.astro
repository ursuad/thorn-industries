---
import BaseLayout from '../layouts/BaseLayout.astro';
import { u } from '../lib/url';
import { pages, type PageKey } from '../content/practice';

interface Props { page: PageKey; lang: 'en' | 'ro'; }
const { page, lang } = Astro.props;
const t = pages[lang][page];
const ro = lang === 'ro';
const contact = ro ? '/ro/contact' : '/contact';
---

<BaseLayout title={`${t.label} · Thorn Industries`} description={t.description} lang={lang}>
  <section class="surface-light pt-12 md:pt-20 pb-16 md:pb-24">
    <div class="container-page">
      <div class="eyebrow text-forest-700 mb-8">001 · {t.label}</div>
      <div class="grid lg:grid-cols-12 gap-10">
        <div class="lg:col-span-9">
          <h1 class="font-medium text-display-1 hang max-w-4xl">{t.heading}<br/><span class="text-forest-700">{t.accent}</span></h1>
          <p class="mt-8 text-body-lg text-ink-700 max-w-2xl">{t.description}</p>
          <div class="mt-10 flex flex-wrap gap-3">
            <a href={page === 'contact' ? 'mailto:contact@thorn.ro' : u(contact)} class="btn-primary">{page === 'contact' ? (ro ? 'Scrieți-ne un email' : 'Email us') : (ro ? 'Să discutăm proiectul' : 'Discuss a work package')} <span aria-hidden="true">↗</span></a>
            <a href={u(ro ? '/ro/servicii' : '/services')} class="btn-secondary">{ro ? 'Ce putem livra' : 'Explore our services'}</a>
          </div>
        </div>
        <aside class="lg:col-span-3 lg:border-l border-forest-100 lg:pl-8 lg:pt-2">
          <div class="eyebrow text-ink-500 mb-4">{ro ? 'Ce facem' : 'Engineering focus'}</div>
          <p class="font-mono text-body-sm leading-loose">{ro ? 'Platforme de date' : 'Data platforms'}<br/>{ro ? 'Automatizare cloud' : 'Cloud & platform'}<br/>{ro ? 'Integrări de sisteme' : 'Systems integration'}<br/>{ro ? 'Fluxuri de lucru cu AI' : 'Applied AI workflows'}</p>
          <p class="border-t border-forest-100 mt-6 pt-6 text-body-sm text-ink-600">{ro ? 'Din România, pentru proiecte europene. Echipa și disponibilitatea se stabilesc pentru fiecare proiect.' : 'Based in Romania. Working across Europe. Team and availability agreed per engagement.'}</p>
        </aside>
      </div>
    </div>
  </section>

  {t.sections.map((section, i) => (
    <section id={section.id} class:list={['section', i % 2 === 0 ? 'surface-medium' : 'surface-light']}>
      <div class="container-page">
        <div class="grid md:grid-cols-12 gap-6 md:gap-10 mb-10 md:mb-14">
          <div class="md:col-span-3 eyebrow text-forest-700 pt-2">{String(i + 2).padStart(3, '0')} · {section.label}</div>
          <div class="md:col-span-9">
            <h2 class="font-medium text-display-2 max-w-3xl hang">{section.heading}</h2>
            {section.intro && <p class="text-body-lg text-ink-700 mt-6 max-w-2xl">{section.intro}</p>}
          </div>
        </div>
        <div class:list={['grid gap-6 md:gap-8', section.items.length === 3 ? 'md:grid-cols-3' : 'md:grid-cols-2']}>
          {section.items.map((item, n) => (
            <article id={item.id} class="card-primary flex flex-col">
              <div class="eyebrow text-forest-700 mb-6">{item.kicker || String(n + 1).padStart(2, '0')}</div>
              <h3 class="font-semibold text-display-4 mb-4">{item.title}</h3>
              <p class="text-body-sm text-ink-700">{item.body}</p>
              {item.deliverable && <div class="border-t border-forest-100 mt-6 pt-6"><div class="eyebrow text-forest-700 mb-3">{ro ? 'Ce primiți' : 'What you receive'}</div><p class="text-body-sm text-ink-700">{item.deliverable}</p></div>}
              {item.href && <a class="btn-link mt-8 self-start" href={item.href.startsWith('/') ? u(item.href) : item.href}>{item.link} <span aria-hidden="true">↗</span></a>}
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  {page === 'contact' ? (
    <section class="surface-dark section">
      <div class="container-page grid md:grid-cols-2 gap-12">
        <div>
          <div class="eyebrow mb-6">{ro ? 'Contact direct' : 'Direct contact'}</div>
          <h2 class="text-display-3 font-medium mb-8">{ro ? 'Descrieți problema în câteva rânduri.' : 'A few lines about the problem.'}</h2>
          <a class="text-xl sm:text-2xl font-medium" href="mailto:contact@thorn.ro">contact@thorn.ro</a>
          <p class="text-cream-100/80 text-body-sm mt-6 max-w-md">{ro ? 'Linkurile deschid aplicația de email. Includeți o descriere generală a proiectului, fără date confidențiale sau documente ale clienților.' : 'These links open your email app. Start with a project outline; leave out confidential data and client documents.'}</p>
        </div>
        <div class="space-y-8 md:border-l border-forest-700 md:pl-12">
          <div><h3 class="eyebrow mb-3">{ro ? 'Discuții tehnice · Adrian Ursu' : 'Technical enquiries · Adrian Ursu'}</h3><a href="mailto:adrian@thorn.ro">adrian@thorn.ro</a></div>
          <div><h3 class="eyebrow mb-3">{ro ? 'Alte întrebări · Ioana Drăghici' : 'Further enquiries · Ioana Drăghici'}</h3><a href="mailto:ioana@thorn.ro">ioana@thorn.ro</a></div>
          <p class="text-body-sm text-cream-100/80">Tech Camp Pro SRL<br/>Str. Traian Vuia 95, Cluj-Napoca<br/>{ro ? 'CUI' : 'Company no.'}: 53945382</p>
        </div>
      </div>
    </section>
  ) : (
    <section class="surface-dark section">
      <div class="container-page grid md:grid-cols-12 gap-10 items-center">
        <div class="md:col-span-8"><div class="eyebrow mb-6">{ro ? 'Primul pas' : 'Start with the problem'}</div><h2 class="text-display-2 font-medium mb-6">{ro ? 'Ce trebuie să funcționeze mai bine?' : 'What needs to work better?'}</h2><p class="text-body-lg text-cream-100/80 max-w-2xl">{ro ? 'Spuneți-ne ce blochează proiectul, ce sisteme sunt implicate și cine va valida rezultatul.' : 'Tell us what is blocked, which systems are involved and who will accept the result.'}</p></div>
        <div class="md:col-span-4 md:justify-self-end"><a href={u(contact)} class="btn-secondary !text-cream-50 !border-forest-300 hover:!bg-forest-800">{ro ? 'Să discutăm' : 'Start a conversation'} <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>
  )}
</BaseLayout>
